---
import Toggle from "./toggle.astro";
---

<section
  id="stage"
  class="stage"
  data-preview="enhanced"
  aria-labelledby="preview-title"
>
  <div class="stage-head">
    <div class="eyebrow" id="preview-title">Preview</div>
    <Toggle
      name="preview"
      size="m"
      value="enhanced"
      options={[
        { label: "Enhanced", value: "enhanced" },
        { label: "Fallback", value: "fallback" },
      ]}
    />
  </div>
  <figure aria-hidden="true" class="preview-wrapper">
    <div id="preview-card" class="preview-card">
      The corner-shape property is used to modify the shape of rounded corners
      created by the border-radius property and its associated longhands
    </div>
  </figure>
  <output id="value-readout" class="value-readout code" aria-hidden="true"
    >border-radius: 1rem;<br />corner-shape: squircle;</output
  >
</section>

<style>
  .stage {
    display: grid;
    gap: 0.8rem;
  }

  @media (width >= 54rem) {
    .stage {
      position: sticky;
      top: 1rem;
    }
  }

  .stage-head {
    display: grid;
    gap: 0.4rem;
  }

  .preview-card {
    --fill: calc(var(--size) * min(1, var(--ratio)));
    --shadow-color: color-mix(in oklch, var(--color-dot) 28%, transparent 50%);
    --shadow-color-light: color-mix(
      in oklch,
      var(--color-card-start) 18%,
      transparent 50%
    );

    overflow: hidden;
    display: grid;
    place-items: center;

    box-sizing: border-box;
    aspect-ratio: var(--ratio);
    inline-size: calc(100% * var(--fill));

    padding: calc(var(--p) * var(--fill));
    border-radius: var(--radius);

    font-size: var(--fs);
    line-height: 1.35;
    color: var(--color-card-text);
    text-align: center;

    background: linear-gradient(
      145deg,
      var(--color-card-start),
      var(--color-card-end)
    );
    box-shadow:
      0 -8px 18px 1px var(--shadow-color),
      0 8px 18px 1px var(--shadow-color),
      -8px 0 18px 1px var(--shadow-color-light),
      8px 0 18px 1px var(--shadow-color-light);

    corner-shape: var(--shape-tl) var(--shape-tr) var(--shape-br)
      var(--shape-bl);
  }

  .stage[data-preview="fallback"] .preview-card {
    border-radius: var(--fb-radius);
    clip-path: none;

    corner-shape: round;
  }

  .stage[data-preview="fallback"][data-exact="true"] .preview-card,
  :global(:root[data-corner-shape="unsupported"])
    .stage[data-preview="enhanced"][data-clip="path"]
    .preview-card {
    border-radius: 0;
    clip-path: var(--preview-clip);
  }

  :global(:root[data-corner-shape="unsupported"])
    .stage[data-preview="enhanced"][data-square="true"]
    .preview-card {
    border-radius: 0;
  }

  .preview-wrapper {
    display: grid;
    place-items: center;
    padding: 1.4rem;
    background: var(--background-dots);
  }

  .value-readout {
    overflow: hidden;
    display: block;

    font-size: 1.2rem;
    font-weight: 500;
    white-space: break-spaces;
  }

  @media (width <= 48rem) {
    .stage {
      position: static;
    }
  }
</style>
