---
import { PRESETS } from "../_lib/controls";

import Toggle from "./toggle.astro";

type Props = {
  name: string;
  target: string;
  legend: string;
  value: string;
  class?: string;
};

const { name, target, legend, value, class: className } = Astro.props;
---

<Toggle
  class={className}
  name={name}
  legend={legend}
  value={value}
  block
  options={PRESETS.map((preset) => ({
    label: preset.label,
    value: preset.value,
    presetFor: target,
  }))}
/>
