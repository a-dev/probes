---
import { PRESETS } from "../_lib/controls";

import Toggle from "./toggle.astro";

// The named stops on the shape scale, laid out as one six-position switch. Picking a stop
// writes its number into the shape field it points at, and the field writes back: a stop
// stays lit only while the number still matches it, so dragging the slider off `2` quietly
// un-checks Squircle — and the toggle, having nothing checked, hides its thumb rather than
// leaving it parked under a stop nobody chose.
interface Props {
  /** Radio group name — one group per shape field. */
  name: string;
  /** `data-bind` key of the shape field this group drives. */
  target: string;
  legend: string;
  /** Value of the stop that starts lit. */
  value: string;
  class?: string;
}

const { name, target, legend, value, class: className } = Astro.props;
---

<Toggle
  class={className}
  name={name}
  legend={legend}
  value={value}
  block
  options={PRESETS.map((preset) => ({
    label: preset.label,
    value: preset.value,
    presetFor: target,
  }))}
/>
