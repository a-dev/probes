---
import Toggle from "./toggle.astro";
import "./output-section.css";

// The take-away. The order is the point: the fallback declaration comes first so every
// browser gets something, and the `@supports` block that follows only reaches browsers
// that can honour the real shape. `_lib/emit.ts` builds the text, this is the frame
// around it plus the two things you might want to change about it — the selector it is
// written for and the unit its lengths are in.
---

<section class="output-section" aria-labelledby="output-title">
  <pre id="css-output" class="css-output" tabindex="0"></pre>
  <div class="output-controls">
    <div>
      {
        /* The two labels are stacked on top of each other so the swap can cross-fade;
      `visibility` keeps the inactive one out of the accessible name. */
      }
      <button
        id="copy-css"
        class="button copy-css-button rounded-m"
        type="button"
        aria-live="polite"
      >
        <span class="copy-css-label copy-css-label-idle">Copy CSS</span>
        <span class="copy-css-label copy-css-label-copied">Copied!</span>
      </button>
    </div>
    <div class="output-options">
      {
        /* Styled after moderncss.dev's pure-CSS checkbox: the native input keeps all of
        its behaviour, `appearance: none` takes away only the paint, and a `::before`
        clipped into a tick draws the checked state. Everything sizes in `em`, so the
        box grows with the label's font-size and nothing needs to be re-measured. */
      }
      <label class="exact-toggle">
        <input class="exact-toggle-input" type="checkbox" name="exact" />
        <span>Exact fallback</span>
      </label>
      <label class="selector-field">
        <span class="field-label">Selector</span>
        <input
          class="text-input rounded-xs class-name-input"
          name="selector"
          type="text"
          value=".card"
        />
      </label>
      <Toggle
        name="unit"
        legend="Unit"
        value="rem"
        class="unit-toggle"
        options={[
          { label: "rem", value: "rem" },
          { label: "px", value: "px" },
        ]}
      />
    </div>
  </div>
</section>
