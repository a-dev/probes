---
import {
  DEFAULT_RADIUS,
  DEFAULT_RADIUS_UNIT,
  DEFAULT_SHAPE,
  RADIUS_RANGE,
  RADIUS_UNITS,
  radiusStepFor,
  SHAPE_RANGE,
} from "../_lib/controls";

import PresetToggle from "./preset-toggle.astro";
import SliderField from "./slider-field.astro";

type Props = {
  target: "all" | "tl" | "tr" | "br" | "bl";
  label?: string;
};

const { target, label = "" } = Astro.props;

const isAll = target === "all";
const shapeLabel = isAll ? "Shape" : `${label} shape`;
const radiusLabel = isAll ? "Radius" : `${label} radius`;
---

<PresetToggle
  name={`preset-${target}`}
  target={`shape-${target}`}
  legend={isAll ? "Presets" : "Preset"}
  value={DEFAULT_SHAPE}
  class="preset-group"
/>

<SliderField
  name={`shape-${target}`}
  label={shapeLabel}
  min={SHAPE_RANGE.min}
  max={SHAPE_RANGE.max}
  step={SHAPE_RANGE.step}
  value={DEFAULT_SHAPE}
  type="text"
  ariaValueText="squircle"
  class="shape-control"
>
  Superellipse
</SliderField>

<SliderField
  name={`radius-${target}-x`}
  label="Radius"
  glyph="↔"
  ariaLabel={`${radiusLabel} horizontal`}
  groupLabel={radiusLabel}
  secondAxis={{
    name: `radius-${target}-y`,
    label: "Radius",
    glyph: "↕",
    ariaLabel: `${radiusLabel} vertical`,
  }}
  min={RADIUS_RANGE.min}
  max={RADIUS_RANGE.max}
  step={radiusStepFor(DEFAULT_RADIUS_UNIT)}
  value={DEFAULT_RADIUS}
  units={RADIUS_UNITS}
  unitValue={DEFAULT_RADIUS_UNIT}
  unitName={`radius-${target}-unit`}
/>
