---
import { CORNER_LABELS } from "../_lib/controls";
import CardProperties from "./card-properties.astro";
import CornerFields from "./corner-fields.astro";
import Toggle from "./toggle.astro";
// import "./shape-settings.css";

// The corners. Two sets of the same controls live in the markup at once and the mode
// switch shows one of them — keeping both mounted means the form always serialises a
// complete answer for whichever mode is active, so nothing has to be reconstructed when
// you flip between them.
---

<section class="root" aria-labelledby="controls-title">
  <div class="header">
    <div class="eyebrow">Controls</div>
    <CardProperties />
  </div>
  <Toggle
    class="mode-toggle"
    name="mode"
    legend="Corner shapes"
    size="m"
    value="all"
    options={[
      { label: "All", value: "all" },
      { label: "Individual", value: "individual" },
    ]}
  />

  <div class="corner-controls all-controls">
    <CornerFields target="all" />
  </div>

  <div class="corner-grid individual-controls">
    {
      CORNER_LABELS.map(({ id, label }) => (
        <fieldset class="corner-group">
          <legend class="field-label corner-group-legend">{label}</legend>
          <CornerFields target={id} label={label} />
        </fieldset>
      ))
    }
  </div>
</section>
<style>
  .root {
  }

  .header {
    padding-block-end: 2rem;
    border-block-end: 1px solid var(--color-border);
  }

  .title {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0;
  }

  :global(.mode-toggle) {
    margin-block: 0.8rem 1.8rem;
  }

  .header-corners {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
  }
  .corner-controls,
  .corner-group {
    display: grid;
    gap: 0.8rem;
  }

  .corner-grid {
    display: none;
    gap: 1.8rem;
  }

  /* Both sets of controls stay in the DOM and the mode switch shows one of them, so the
   form always serialises a complete answer for whichever mode is active. */

  :global(.generator-form[data-mode="individual"]) .all-controls {
    display: none;
  }

  :global(.generator-form[data-mode="individual"]) .individual-controls {
    display: grid;
  }

  .corner-group {
    min-width: 0;
    padding: 0.6rem 0;
    border: 0;
    border-top: 5px solid var(--color-group-border);
  }

  .corner-group-legend {
    padding-inline-end: 0.8rem;

    font-family: var(--font-atkinson-mono), ui-monospace, monospace;
    font-size: 1.1rem;
    color: var(--color-code-text);
    text-transform: lowercase;
  }
</style>
