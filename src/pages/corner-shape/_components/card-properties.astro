---
import { DIMENSIONS } from "../_lib/controls";

import SliderField from "./slider-field.astro";
---

<details class="root">
  <summary class="summary">Size and text <span class="arrow">→</span></summary>
  <div class="card-properties-content">
    <label class="field">
      <span class="field-label">Preview text</span>
      <textarea class="text-input rounded-xs" name="text" rows="3"
        >A little corner of the web.</textarea
      >
    </label>

    <div class="dimension-grid">
      {
        DIMENSIONS.map((dimension) => (
          <SliderField
            name={dimension.name}
            label={dimension.label}
            min={dimension.min}
            max={dimension.max}
            step={dimension.step}
            value={dimension.value}
            unit={dimension.unit}
          />
        ))
      }
    </div>
  </div>
</details>
<style>
  .root {
    &::details-content {
      block-size: 0;
      transition:
        block-size 0.2s linear,
        content-visibility 0.2s linear;
      transition-behavior: allow-discrete;
    }

    &[open] .arrow {
      transform: rotate(45deg);
    }

    &[open]::before {
      width: 100%;
    }

    &[open]::details-content {
      block-size: auto;
    }
  }
  .summary {
    cursor: pointer;

    display: flex;
    gap: 0.8rem;
    align-items: center;

    width: fit-content;

    font-size: 1.4rem;
    font-weight: 700;

    &::marker {
      content: "";
    }
  }

  .arrow {
    display: inline-block;
    margin-top: -1px;
    font-weight: 800;
    font-size: 1.1rem;
    transition: transform 0.2s linear;
  }

  .card-properties-content {
    padding-top: 1rem;
    background: var(--color-page-background);
  }

  .dimension-grid {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }
</style>
