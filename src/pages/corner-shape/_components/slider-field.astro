---
import Toggle from "./toggle.astro";

// One number, three inputs. `_lib/form.ts` keeps the pair mirrored through `data-bind`.
type Props = {
  name: string;
  label: string;
  min: number | string;
  max: number | string;
  step: number | string;
  value: number | string;
  unit?: string;
  type?: "number" | "text"; // `text` accepts `infinity`, which a number input would reject.
  ariaValueText?: string;
  units?: { label: string; value: string }[];
  unitValue?: string;
  class?: string;
};

const {
  name,
  label,
  min,
  max,
  step,
  value,
  unit,
  type = "number",
  ariaValueText,
  units,
  unitValue,
  class: className,
} = Astro.props;

const isText = type === "text";
---

<fieldset class:list={["control-pair", className]}>
  <legend class="field-label"><slot>{label}</slot></legend>
  <input type="hidden" name={name} value={value} data-value-for={name} />
  <input
    class="range-input rounded-xs"
    type="range"
    min={min}
    max={max}
    step={step}
    value={value}
    data-bind={name}
    aria-label={`${label} slider`}
    aria-valuetext={ariaValueText}
  />
  <input
    class="text-input rounded-s"
    type={type}
    inputmode={isText ? "decimal" : undefined}
    min={isText ? undefined : min}
    max={isText ? undefined : max}
    step={isText ? undefined : step}
    value={value}
    data-bind={name}
    aria-label={unit ? `${label} value, ${unit}` : `${label} value`}
  />
  {
    units && (
      <Toggle
        class="unit-switch"
        name={`${name}-unit`}
        ariaLabel={`${label} unit`}
        options={units}
        value={unitValue}
        unitFor={name}
      />
    )
  }
</fieldset>
<style>
  :global(.unit-switch .toggle-option) {
    padding-inline: 0.6rem;
    font-size: 0.8rem;
  }
</style>
