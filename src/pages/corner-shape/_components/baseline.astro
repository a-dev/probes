---
import "./baseline.css";
---

<footer class="support-panel">
  <div>
    <p class="eyebrow">Browser support</p>
    <h2 class="section-title">What the fallback costs you</h2>
    <p class="support-panel-text">
      No <code class="code">border-radius</code> value bends inward, so a scoop or
      a notch has no rounded equivalent at all. The exact tier draws them properly,
      but a clip path also cuts off box shadows, outlines, and any border sitting
      outside it.
    </p>
  </div>
  <baseline-status class="baseline-status" featureId="corner-shape">
    Support data didn't load. Check the Web Platform Status dashboard.
  </baseline-status>
</footer>

<script>
  import "baseline-status";
</script>
