---
import Credits from "./credits.astro";
---

<script>
  import "baseline-status";

  const el = document.querySelector("baseline-status");
  const sheet = new CSSStyleSheet();
  sheet.replaceSync(".name { display: none !important; }");

  if (el?.shadowRoot?.adoptedStyleSheets) {
    el.shadowRoot.adoptedStyleSheets = [
      ...el.shadowRoot.adoptedStyleSheets,
      sheet,
    ];
  }
</script>

<footer class="root">
  <div class="support-panel">
    <div class="support-panel-content">
      Browser support of&nbsp;<code class="code code-no-wrap">corner-shape</code
      >
    </div>
    <baseline-status class="baseline-status" featureId="corner-shape">
      Support data didn't load. Check the Web Platform Status dashboard.
    </baseline-status>
  </div>
  <Credits />
</footer>

<style>
  .root {
    isolation: isolate;
    position: relative;
    padding-block: 6rem 2rem;
    max-width: 50rem;
    margin-inline: auto;
  }
  .root:before {
    content: "";
    position: absolute;
    z-index: -1;
    inset-block-start: 0;
    inset-inline-start: 50%;
    transform: translateX(-50%);
    display: block;
    width: 100dvw;
    height: 100%;
    background: var(--background-dots);
    opacity: 0.6;
  }
  .support-panel {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    align-items: center;

    padding-block: 1.8rem;
    padding-inline: 2.4rem;
    border: 1px solid var(--color-border);

    border-radius: 3.205rem;

    background: white;
  }

  @supports (corner-shape: superellipse(1.8)) {
    .support-panel {
      border-radius: 4.9rem;

      corner-shape: superellipse(1.8);
    }
  }

  .support-panel-content {
    font-size: clamp(1.1rem, 4vw, 1.7rem);
    font-weight: 700;
    line-height: 1.24;

    & .code {
      font-weight: 700;
    }
  }

  .baseline-status {
    padding: 0;
    border: 0;
    border-radius: 0;
  }

  baseline-status::part(name) {
    display: none;
  }

  @media (width <= 48rem) {
    .support-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
