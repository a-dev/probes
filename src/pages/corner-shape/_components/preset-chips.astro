---
import { DEFAULT_SHAPE, PRESETS } from "../_lib/controls";

// The named stops on the shape scale. Picking one writes its number into the shape field
// it points at, and the field writes back: a preset stays lit only while the number still
// matches it, so dragging the slider off `2` quietly un-checks Squircle.
interface Props {
  /** Radio group name — one group per shape field. */
  name: string;
  /** `data-bind` key of the shape field this group drives. */
  target: string;
  legend: string;
  class?: string;
}

const { name, target, legend, class: className } = Astro.props;
---

<fieldset class:list={["preset-group", className]}>
  <legend class="field-label">{legend}</legend>
  <div class="chip-group">
    {
      PRESETS.map(({ label, value }) => (
        <label class="chip" title={label}>
          <input
            class="chip-input"
            type="radio"
            name={name}
            value={value}
            data-preset-for={target}
            checked={value === DEFAULT_SHAPE}
          />
          {label}
        </label>
      ))
    }
  </div>
</fieldset>
