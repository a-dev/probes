{
  "name": "probes",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check:astro": "bunx --package=typescript@6 --package=@astrojs/check@0.9 astro-check --root .",
    "dev": "astro dev --host",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint && stylelint \"src/**/*.css\"",
    "lint:fix": "oxlint --fix && stylelint --fix \"src/**/*.css\"",
    "preview": "astro preview",
    "test": "vitest run",
    "typecheck": "oxlint --type-aware",
    "update:interactive": "npx npm-check-updates --interactive -u --packageManager bun --format group --cooldown 2"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.2",
    "@speed-highlight/core": "^1.2.23",
    "@tanstack/react-form": "^1.33.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.1.6",
    "baseline-status": "^1.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "stylelint": "^17.14.1",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "vite": "^8.2.0",
    "vite-css-modules": "^1.16.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
